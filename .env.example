# Copy this file to .env and fill in real values before running
# `docker-compose up`. Never commit the real .env file.

# --- Database ---
DB_NAME=urlshortener
DB_USER=root
DB_PASSWORD=change-me-locally
DB_USE_SSL=false

# --- Redis ---
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# --- Kafka (leave as PLAINTEXT for local docker-compose; see README for
#     managed-Kafka / Render deployment values) ---
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_JAAS_CONFIG=

# --- JWT ---
# Generate a real value with: openssl rand -base64 48
# Must be at least 32 characters - the app refuses to start otherwise.
JWT_SECRET=dev-only-secret-change-this-to-a-random-48-byte-value-before-deploying
JWT_EXPIRATION_MS=86400000

# --- App ---
APP_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080
RATE_LIMIT_PER_MINUTE=20
CACHE_TTL_HOURS=24
ANALYTICS_RECONCILE_INTERVAL_MS=300000

# --- Logging ---
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_SECURITY=WARN
# "prod" switches logback-spring.xml to structured key=value logs.
# Leave unset (or "default") for human-readable console logs locally.
SPRING_PROFILES_ACTIVE=
